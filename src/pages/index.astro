---
import Layout from '../layouts/Layout.astro';
import skills from '../data/skills.json';
import { 
  Github, 
  ArrowRight, 
  Eye, 
  Download, 
  TrendingUp, 
  Search, 
  Wallet,
  Globe,
  ArrowLeftRight,
  LineChart
} from 'lucide-react';
---

<Layout title="Home">
  <div style="background-color: #000000; min-height: 100vh; color: #ffffff; overflow-x: hidden;">
    
    <!-- Navbar Border -->
    <div style="height: 1px; background-color: #222;"></div>

    <!-- Hero Section -->
    <div style="border-bottom: 1px solid #222;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 80px 24px 100px;">
        
        <div class="hero-container" style="display: flex; flex-direction: column; lg:flex-row; gap: 64px; align-items: center;">
          
          <!-- Left Content -->
          <div style="flex: 1; width: 100%;">
            <!-- Badge -->
            <div style="
              display: inline-flex; 
              align-items: center; 
              gap: 8px; 
              padding: 6px 12px; 
              border: 1px solid #333; 
              border-radius: 100px; 
              margin-bottom: 32px;
              font-size: 13px;
              color: #888;
              font-weight: 500;
            ">
              <span style="width: 8px; height: 8px; background-color: #3b82f6; border-radius: 50%; box-shadow: 0 0 10px rgba(59, 130, 246, 0.5);"></span>
              Open Source Skills Directory
            </div>

            <!-- Title -->
            <h1 class="hero-title" style="
              font-weight: 700; 
              color: #ffffff; 
              margin-bottom: 24px; 
              letter-spacing: -0.03em; 
              line-height: 1.1;
            ">
              Polymarket Skills
            </h1>

            <!-- Description -->
            <p class="hero-desc" style="
              font-size: 18px; 
              color: #888; 
              margin-bottom: 40px; 
              line-height: 1.6;
              max-width: 540px;
            ">
              Power your AI agents with real-time prediction market data. Search markets, execute trades, and analyze portfolios instantly.
            </p>

            <!-- Buttons -->
            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <a href="#skills" style="
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 24px;
                background-color: #ffffff;
                color: #000000;
                font-size: 15px;
                font-weight: 600;
                text-decoration: none;
                border-radius: 8px;
                transition: background-color 0.2s;
              " class="btn-primary">
                Browse Skills
                <ArrowRight size={16} />
              </a>
              <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style="
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 24px;
                background-color: #000000;
                color: #ffffff;
                border: 1px solid #333;
                font-size: 15px;
                font-weight: 600;
                text-decoration: none;
                border-radius: 8px;
                transition: border-color 0.2s;
              " class="btn-secondary">
                <Github size={16} />
                GitHub
              </a>
            </div>
          </div>

          <!-- Right Content (Terminal) -->
          <div style="flex: 1; width: 100%; min-width: 0;">
            <div style="
              background-color: #0a0a0a;
              border: 1px solid #333;
              border-radius: 16px;
              padding: 24px;
              box-shadow: 0 20px 40px -10px rgba(0,0,0,0.5);
              overflow: hidden;
            ">
              <!-- Terminal Header -->
              <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; padding-bottom: 16px; border-bottom: 1px solid #222;">
                <div style="display: flex; gap: 8px;">
                  <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #ef4444;"></div>
                  <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #eab308;"></div>
                  <div style="width: 12px; height: 12px; border-radius: 50%; background-color: #22c55e;"></div>
                </div>
                <div style="font-family: monospace; font-size: 12px; color: #444;">agent.ts</div>
              </div>

              <!-- Terminal Content -->
              <div style="font-family: 'JetBrains Mono', monospace; font-size: 13px; line-height: 1.6;">
                
                <!-- Command -->
                <div style="margin-bottom: 20px;">
                  <span style="color: #666;"># Market Discovery</span><br/>
                  <span style="color: #3b82f6;">></span> <span style="color: #fff;">Check odds for "Will GPT-5 launch in 2025?"</span>
                </div>

                <!-- Response -->
                <div style="
                  background-color: #111;
                  border-left: 2px solid #3b82f6;
                  padding: 16px;
                  border-radius: 4px;
                  color: #d4d4d4;
                  margin-bottom: 20px;
                ">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                    <span style="color: #fff; font-weight: 600;">GPT-5 Release 2025</span>
                    <span style="color: #22c55e;">Vol: $4.2M</span>
                  </div>
                  
                  <div style="display: flex; gap: 2px; height: 6px; width: 100%; background: #222; border-radius: 3px; overflow: hidden; margin-bottom: 12px;">
                    <div style="width: 32%; background: #22c55e;"></div>
                    <div style="width: 68%; background: #ef4444;"></div>
                  </div>

                  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px;">
                    <div style="background: rgba(34, 197, 94, 0.1); padding: 8px; border-radius: 4px; border: 1px solid rgba(34, 197, 94, 0.2);">
                      <div style="font-size: 11px; color: #86efac;">YES</div>
                      <div style="font-size: 16px; font-weight: 700; color: #fff;">32¢</div>
                    </div>
                    <div style="background: rgba(239, 68, 68, 0.1); padding: 8px; border-radius: 4px; border: 1px solid rgba(239, 68, 68, 0.2);">
                      <div style="font-size: 11px; color: #fca5a5;">NO</div>
                      <div style="font-size: 16px; font-weight: 700; color: #fff;">68¢</div>
                    </div>
                  </div>
                </div>

                <!-- Command 2 -->
                <div>
                  <span style="color: #3b82f6;">></span> <span style="color: #fff;">Buy 1000 YES shares at market</span><span style="animation: blink 1s infinite; color: #3b82f6;">_</span>
                </div>

              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <!-- Skills Section -->
    <div style="max-width: 1200px; margin: 0 auto; padding: 100px 24px;">
      
      <!-- Section Header -->
      <div id="skills" style="
        display: flex; 
        align-items: center; 
        justify-content: space-between; 
        margin-bottom: 40px; 
        padding-bottom: 24px; 
        border-bottom: 1px solid #333;
      ">
        <div style="display: flex; align-items: center; gap: 12px;">
          <h2 style="font-size: 24px; font-weight: 600; color: #ffffff; margin: 0;">Available Skills</h2>
          <span style="
            background-color: #1a1a1a; 
            color: #888; 
            padding: 2px 8px; 
            border-radius: 4px; 
            font-size: 14px; 
            font-weight: 500;
          ">{skills.length}</span>
        </div>
      </div>

      <!-- Skills Grid -->
      <div class="skills-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 24px;">
        {skills.map((skill) => {
          // Determine unique icon based on skill ID or name
          let SkillIcon = Search;
          if (skill.name.includes("Trading") && !skill.name.includes("Insights")) {
            SkillIcon = ArrowLeftRight; // Trading icon
          } else if (skill.name.includes("Intelligence") || skill.name.includes("Market")) {
            SkillIcon = Globe; // Discovery icon
          } else if (skill.name.includes("Insights") || skill.name.includes("Portfolio")) {
            SkillIcon = LineChart; // Analytics icon
          }

          return (
            <a href={`/skills/${skill.id}`} style="text-decoration: none; color: inherit; display: block;">
              <div style="
                height: 100%;
                padding: 32px; 
                border: 1px solid #333; 
                border-radius: 12px; 
                background-color: #000; 
                transition: all 0.2s;
              " class="skill-card">
                
                <!-- Header -->
                <div style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 24px;">
                  <div style="
                    width: 48px; 
                    height: 48px; 
                    border: 1px solid #333; 
                    border-radius: 8px; 
                    display: flex; 
                    align-items: center; 
                    justify-content: center;
                    background-color: #111;
                  ">
                    <SkillIcon size={24} color="#fff" />
                  </div>
                  <div style="
                    padding: 4px 8px; 
                    border: 1px solid #333; 
                    border-radius: 4px; 
                    font-size: 12px; 
                    color: #666; 
                    font-family: monospace;
                    display: flex;
                    align-items: center;
                    gap: 6px;
                  ">
                    <div style="width: 6px; height: 6px; background-color: #22c55e; border-radius: 50%;"></div>
                    v1.0.0
                  </div>
                </div>

                <h3 style="font-size: 18px; font-weight: 600; color: #ffffff; margin: 0 0 12px 0;">
                  {skill.name}
                </h3>

                <p style="font-size: 15px; color: #888; line-height: 1.6; margin: 0 0 24px 0; min-height: 48px;">
                  {skill.description}
                </p>

                <!-- Tags -->
                <div style="display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 32px;">
                  {skill.tags.slice(0, 3).map((tag) => (
                    <span style="
                      padding: 4px 10px; 
                      border: 1px solid #333; 
                      border-radius: 100px; 
                      font-size: 12px; 
                      color: #888;
                    ">
                      {tag}
                    </span>
                  ))}
                </div>

                <!-- Footer -->
                <div style="
                  display: flex; 
                  align-items: center; 
                  gap: 24px; 
                  padding-top: 24px; 
                  border-top: 1px solid #222;
                  color: #666;
                  font-size: 13px;
                ">
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <Eye size={14} />
                    {skill.stats?.views || 0}
                  </div>
                  <div style="display: flex; align-items: center; gap: 6px;">
                    <Download size={14} />
                    {skill.stats?.downloads || 0}
                  </div>
                  <div style="margin-left: auto; display: flex; align-items: center; gap: 6px;">
                    <img src="/logo.png" style="width: 16px; height: 16px; border-radius: 4px; filter: grayscale(100%);" />
                    {skill.author}
                  </div>
                </div>

              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</Layout>

<style>
  .hero-title {
    font-size: 64px;
  }
  
  @media (max-width: 1024px) {
    .hero-container {
      flex-direction: column;
      text-align: center;
    }
    
    .hero-title {
      font-size: 48px;
    }
    
    .hero-desc {
      margin-left: auto;
      margin-right: auto;
    }
    
    .hero-container > div:first-child {
      display: flex;
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 640px) {
    .hero-title {
      font-size: 36px;
    }
    
    .skills-grid {
      grid-template-columns: 1fr !important;
    }
  }

  .btn-primary:hover {
    background-color: #e5e5e5 !important;
  }
  
  .btn-secondary:hover {
    border-color: #666 !important;
    color: #fff !important;
  }

  .skill-card:hover {
    border-color: #666 !important;
    transform: translateY(-2px);
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
