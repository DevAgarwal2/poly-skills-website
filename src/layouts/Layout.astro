---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Polymarket Agent Skills Directory" } = Astro.props;
---

<!doctype html>
<html lang="en" style="margin: 0; padding: 0; background-color: #0a0a0f; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | Polymarket Skills</title>

    <!-- Open Graph / Social Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | Polymarket Skills`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/og-image.svg" />
    <meta property="og:url" content="https://poly-skills.vercel.app" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Polymarket Skills`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/og-image.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      :root {
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background-color: #0a0a0f !important;
        color: #e5e5e5;
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
      }
      a { text-decoration: none; color: inherit; }
    </style>
  </head>
  <body style="background-color: #0a0a0f !important; min-height: 100vh; display: flex; flex-direction: column;">
    <header style={{
      position: 'sticky',
      top: 0,
      zIndex: 50,
      backgroundColor: 'rgba(10, 10, 15, 0.8)',
      backdropFilter: 'blur(12px)',
      borderBottom: '1px solid rgba(255,255,255,0.06)'
    }}>
      <div style={{
        maxWidth: '1200px',
        margin: '0 auto',
        padding: '16px 24px',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between'
      }}>
        <a href="/" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <div style={{
            width: '40px',
            height: '40px',
            borderRadius: '10px',
            background: 'linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(59, 130, 246, 0.05) 100%)',
            border: '1px solid rgba(59, 130, 246, 0.2)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center'
          }}>
            <svg style={{ width: '20px', height: '20px', color: '#60a5fa' }} viewBox="0 0 24 24" fill="none">
              <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div>
            <span style={{ fontSize: '16px', fontWeight: '700', color: '#ffffff', display: 'block' }}>Polymarket</span>
            <span style={{ fontSize: '12px', color: '#71717a', display: 'block', marginTop: '-2px' }}>Skills</span>
          </div>
        </a>

        <nav style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
          <a href="https://github.com/anthropics/skills" target="_blank" style={{
            fontSize: '13px',
            color: '#71717a',
            padding: '8px 14px',
            borderRadius: '8px',
            transition: 'all 0.2s'
          }}>
            Documentation
          </a>
          <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style={{
            color: '#71717a',
            padding: '10px',
            borderRadius: '8px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            transition: 'all 0.2s'
          }}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main style={{ flex: 1 }}>
      <slot />
    </main>

    <footer style={{
      marginTop: 'auto',
      padding: '48px 24px 32px',
      backgroundColor: '#0a0a0f',
      borderTop: '1px solid rgba(255,255,255,0.06)'
    }}>
      <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
          gap: '32px',
          marginBottom: '32px'
        }}>
          <div>
            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '16px' }}>
              <div style={{
                width: '32px',
                height: '32px',
                borderRadius: '8px',
                backgroundColor: 'rgba(59, 130, 246, 0.1)',
                border: '1px solid rgba(59, 130, 246, 0.2)',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center'
              }}>
                <svg style={{ width: '16px', height: '16px', color: '#60a5fa' }} viewBox="0 0 24 24" fill="none">
                  <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M2 17L12 22L22 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M2 12L12 17L22 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </div>
              <span style={{ fontSize: '15px', fontWeight: '600', color: '#e5e5e5' }}>Polymarket Skills</span>
            </div>
            <p style={{ fontSize: '13px', color: '#71717a', lineHeight: 1.6, margin: 0 }}>
              The ultimate directory of MCP servers and tools for real-time prediction market data and trading automation.
            </p>
          </div>

          <div>
            <h4 style={{ fontSize: '12px', fontWeight: '600', color: '#e5e5e5', marginBottom: '12px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Resources</h4>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              <a href="https://github.com/anthropics/mcp" target="_blank" style={{ fontSize: '13px', color: '#71717a', transition: 'color 0.2s' }}>MCP Documentation</a>
              <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style={{ fontSize: '13px', color: '#71717a', transition: 'color 0.2s' }}>GitHub Repository</a>
            </div>
          </div>

          <div>
            <h4 style={{ fontSize: '12px', fontWeight: '600', color: '#e5e5e5', marginBottom: '12px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Skills</h4>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>
              <span style={{ fontSize: '13px', color: '#71717a' }}>Polymarket Market Intelligence</span>
              <span style={{ fontSize: '13px', color: '#71717a' }}>User Trading Insights</span>
              <span style={{ fontSize: '13px', color: '#71717a', opacity: 0.5 }}>Polymarket Trading (Coming Soon)</span>
            </div>
          </div>
        </div>

        <div style={{
          paddingTop: '24px',
          borderTop: '1px solid rgba(255,255,255,0.06)',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          flexWrap: 'wrap',
          gap: '16px'
        }}>
          <p style={{ margin: 0, fontSize: '12px', color: '#52525b' }}>
            &copy; {new Date().getFullYear()} Polymarket Skills Directory. Open Source.
          </p>
          <div style={{ display: 'flex', alignItems: 'center', gap: '16px' }}>
            <a href="#" style={{ fontSize: '12px', color: '#52525b', transition: 'color 0.2s' }}>Privacy</a>
            <a href="#" style={{ fontSize: '12px', color: '#52525b', transition: 'color 0.2s' }}>Terms</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
