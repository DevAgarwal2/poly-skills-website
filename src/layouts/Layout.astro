---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Build AI agents that trade, analyze markets, and track portfolios on Polymarket. Open source skills and tools for prediction market automation." } = Astro.props;

const siteUrl = "https://polyskills.xyz";
const ogImageUrl = `${siteUrl}/og-image.png`;
const pageTitle = title === "Home" ? "Polymarket Skills - Power Your AI Agent for Prediction Markets" : `${title} | Polymarket Skills`;
---

<!doctype html>
<html lang="en" style="margin: 0; padding: 0; background-color: #0a0a0f; color-scheme: dark;">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>

    <!-- SEO Meta Tags -->
    <meta name="keywords" content="Polymarket, AI agent, prediction markets, MCP server, trading bot, market intelligence, portfolio tracking, cryptocurrency, DeFi, automation" />
    <meta name="author" content="Polymarket Skills" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Polymarket Skills" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Polymarket Skills - Power Your AI Agent for Prediction Markets" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@polymarket" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Polymarket Skills - Power Your AI Agent for Prediction Markets" />
    
    <!-- Additional meta tags -->
    <meta name="theme-color" content="#3b82f6" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
      :root {
        color-scheme: dark;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background-color: #0a0a0f !important;
        color: #e5e5e5;
        font-family: 'Inter', system-ui, sans-serif;
        min-height: 100vh;
      }
      a { text-decoration: none; color: inherit; }
    </style>
  </head>
  <body style="background-color: #0a0a0a !important; min-height: 100vh; display: flex; flex-direction: column;">
    <header style={{
      position: 'sticky',
      top: 0,
      zIndex: 50,
      backgroundColor: 'rgba(10, 10, 10, 0.8)',
      backdropFilter: 'blur(12px)',
      borderBottom: '1px solid #1f1f1f'
    }}>
      <div style={{
        maxWidth: '1200px',
        margin: '0 auto',
        padding: '16px 24px',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'space-between'
      }}>
        <a href="/" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
          <img src="/logo.png" alt="Polymarket Skills" style={{ width: '44px', height: '44px', borderRadius: '10px' }} />
          <div>
            <span style={{ fontSize: '17px', fontWeight: '700', color: '#ffffff', display: 'block' }}>Polymarket</span>
            <span style={{ fontSize: '12px', color: '#71717a', display: 'block', marginTop: '-2px' }}>Skills</span>
          </div>
        </a>

        <nav style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
          <a href="https://modelcontextprotocol.io/docs/getting-started/intro" target="_blank" style={{
            fontSize: '14px',
            color: '#a0a0a0',
            padding: '8px 14px',
            borderRadius: '6px',
            transition: 'color 0.2s'
          }}>
            Docs
          </a>
          <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style={{
            color: '#a0a0a0',
            padding: '8px',
            borderRadius: '6px',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'center',
            transition: 'color 0.2s'
          }}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main style={{ flex: 1 }}>
      <slot />
    </main>

    <footer style={{
      marginTop: 'auto',
      padding: '60px 32px 40px',
      backgroundColor: '#0a0a0a',
      borderTop: '1px solid #1f1f1f'
    }}>
      <div style={{ maxWidth: '1200px', margin: '0 auto' }}>
        <div style={{
          display: 'grid',
          gridTemplateColumns: 'repeat(auto-fit, minmax(200px, 1fr))',
          gap: '48px',
          marginBottom: '48px'
        }}>
          <div>
            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '16px' }}>
              <img src="/logo.png" alt="Polymarket Skills" style={{ width: '32px', height: '32px', borderRadius: '6px' }} />
              <span style={{ fontSize: '16px', fontWeight: '600', color: '#ffffff' }}>Polymarket Skills</span>
            </div>
            <p style={{ fontSize: '14px', color: '#6f6f6f', lineHeight: 1.6, margin: 0 }}>
              Open-source skills for AI agents to interact with Polymarket prediction markets.
            </p>
          </div>

          <div>
            <h4 style={{ fontSize: '13px', fontWeight: '600', color: '#ffffff', marginBottom: '16px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Resources</h4>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
              <a href="https://modelcontextprotocol.io/docs/getting-started/intro" target="_blank" style={{ fontSize: '14px', color: '#a0a0a0', transition: 'color 0.2s' }}>MCP Documentation</a>
              <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style={{ fontSize: '14px', color: '#a0a0a0', transition: 'color 0.2s' }}>GitHub</a>
              <a href="https://polymarket.com" target="_blank" style={{ fontSize: '14px', color: '#a0a0a0', transition: 'color 0.2s' }}>Polymarket</a>
            </div>
          </div>

          <div>
            <h4 style={{ fontSize: '13px', fontWeight: '600', color: '#ffffff', marginBottom: '16px', textTransform: 'uppercase', letterSpacing: '0.05em' }}>Skills</h4>
            <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>
              <span style={{ fontSize: '14px', color: '#a0a0a0' }}>Market Intelligence</span>
              <span style={{ fontSize: '14px', color: '#a0a0a0' }}>Trading Automation</span>
              <span style={{ fontSize: '14px', color: '#a0a0a0' }}>Portfolio Analytics</span>
            </div>
          </div>
        </div>

        <div style={{
          paddingTop: '32px',
          borderTop: '1px solid #1f1f1f',
          display: 'flex',
          alignItems: 'center',
          justifyContent: 'space-between',
          flexWrap: 'wrap',
          gap: '16px'
        }}>
          <p style={{ margin: 0, fontSize: '14px', color: '#6f6f6f' }}>
            &copy; {new Date().getFullYear()} Polymarket Skills. MIT License.
          </p>
          <div style={{ display: 'flex', alignItems: 'center', gap: '24px' }}>
            <a href="https://github.com/DevAgarwal2/poly-skills-website" target="_blank" style={{ fontSize: '14px', color: '#6f6f6f', transition: 'color 0.2s' }}>GitHub</a>
            <a href="https://twitter.com/polymarket" target="_blank" style={{ fontSize: '14px', color: '#6f6f6f', transition: 'color 0.2s' }}>Twitter</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
